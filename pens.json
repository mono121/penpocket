---
layout: null
permalink: /pens.json
---
[{% for pen in site.pens %}{% assign b = site.data.brands[pen.brand] %}
{
  "title": {{ pen.title | jsonify }},
  "brand": {{ pen.brand | jsonify }},
  "brand_name": {{ b.name | default: pen.brand | jsonify }},
  "country": {{ b.country | default: "不明" | jsonify }},
  "type": {{ pen.type | jsonify }},
  "nib": {{ pen.nib | jsonify }},
  "line_width": {{ pen.line_width | default: 0.5 }},
  "tags": {{ pen.tags | default: empty | jsonify }},
  "acquired": {{ pen.acquired }},
  "url": {{ pen.url | relative_url | jsonify }}
}{% unless forloop.last %},{% endunless %}{% endfor %}
]
